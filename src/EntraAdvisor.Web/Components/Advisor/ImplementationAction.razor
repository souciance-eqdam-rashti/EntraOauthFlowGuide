<section class="implementation-action">
@if(Path.Count > 0) { <InstructionLocation Path="Path" Label="@(string.IsNullOrEmpty(PathLabel) ? "Open in Entra" : PathLabel)"/> }
<div class="instruction-configure"><div class="instruction-section-heading"><MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" aria-hidden="true"/><MudText Typo="Typo.subtitle2" Class="action-title">@Title</MudText></div>
<div class="instruction-action-body">@ChildContent</div></div>
</section>
@code {
 [Parameter, EditorRequired] public string Title {get;set;}="Configure";
 [Parameter] public string PathLabel {get;set;}="";
 [Parameter] public IReadOnlyList<string> Path {get;set;}=Array.Empty<string>();
 [Parameter] public RenderFragment? ChildContent {get;set;}
}
