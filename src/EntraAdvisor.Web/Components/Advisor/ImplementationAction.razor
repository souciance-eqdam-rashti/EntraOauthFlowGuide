<section class="implementation-action">
<MudText Typo="Typo.subtitle2" Class="action-title">@Title</MudText>
@if(!string.IsNullOrEmpty(PathLabel)) { <MudText Typo="Typo.caption">@PathLabel</MudText> }
@if(Path.Count > 0) { <p class="action-path">@string.Join(" › ",Path)</p> }
@ChildContent
</section>
@code {
 [Parameter, EditorRequired] public string Title {get;set;}="";
 [Parameter] public string PathLabel {get;set;}="";
 [Parameter] public IReadOnlyList<string> Path {get;set;}=Array.Empty<string>();
 [Parameter] public RenderFragment? ChildContent {get;set;}
}
