@using EntraAdvisor.Guide
<section class="implementation-exports" aria-label="Implementation exports">
    <div class="actions">@ChildContent<button @onclick="() => Export(ValidationScriptFormat.CurlBash)">Export curl (Bash) ↓</button><button @onclick="() => Export(ValidationScriptFormat.CurlWindows)">Export curl (Windows) ↓</button><button @onclick="() => Export(ValidationScriptFormat.PowerShell)">Export PowerShell ↓</button></div>
    @if(status.Length > 0) { <p role="status">@status</p> }
</section>
@code {
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter,EditorRequired] public OAuthPlan Plan {get;set;}=null!;
    [Inject] public IJSRuntime JS {get;set;}=null!;
    private readonly ValidationScriptExporter exporter=new();
    private string status="";
    private async Task Export(ValidationScriptFormat format) {
        var script=exporter.ExportAll(Plan,format);
        status="";
        try {await JS.InvokeVoidAsync("advisor.download",script.FileName,script.Content);} catch(JSException) {status="Download could not start. Please try again.";}
    }
}
