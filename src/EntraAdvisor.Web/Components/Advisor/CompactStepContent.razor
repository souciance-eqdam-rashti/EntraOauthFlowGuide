<div class="implementation-actions">
@foreach(var group in Groups()) {
 @switch(group[0]) {
  case CopyableValueContent reference when reference.Value.ReferenceOnly:
   @foreach(var value in group.Cast<CopyableValueContent>()) { <ImplementationAction Title="@value.Value.Label" Path="@(new[] { "App registrations", ComponentName, "Overview" })"><p>@value.Value.Guidance</p></ImplementationAction> }
   break;
  case CopyableValueContent:
   <ImplementationAction Title="Configure settings"><div class="configuration-rows">@foreach(var value in group.Cast<CopyableValueContent>()) { <ConfigurationValueRow Value="value.Value" /> }</div></ImplementationAction>
   break;
  case PortalActionContent portal:
   <ImplementationAction Title="@portal.Title" Path="@PortalPath(portal.Breadcrumbs)"><p>@portal.Action</p></ImplementationAction>
   break;
  case InstructionContent:
   <ImplementationAction Title="@GroupTitle(group)" Path="@((group[0] as InstructionContent)!.Location)" PathLabel="@((group[0] as InstructionContent)!.LocationLabel)">@foreach(var instruction in group.Cast<InstructionContent>()) { <p>@instruction.Text</p> }</ImplementationAction>
   break;
  case ConfigurationRowsContent rows:
   <ImplementationAction Title="@rows.Title" Path="@PortalPath(rows.Breadcrumbs)"><div class="configuration-rows">@foreach(var value in rows.Values) { <ConfigurationValueRow Value="value" CanCopy="@(value.CanCopy && value.Kind != GuideValueKind.Derived)" /> }</div><p>@rows.Instruction</p></ImplementationAction>
   break;
  case CodeContent snippet:
   <ImplementationAction Title="@(snippet.Artifact.ExecutionLocation is not null ? "Run the commands" : "Apply the code")" Path="@(new[] { snippet.Artifact.ExecutionLocation ?? snippet.Artifact.DestinationFile })" PathLabel="@(snippet.Artifact.ExecutionLocation is null ? "File location" : "Execution location")"><pre><code>@((MarkupString)CodeHighlighter.Render(snippet.Artifact.Content))</code></pre></ImplementationAction>
   break;
  case ExplanationContent explanation:
   <MudExpansionPanels Elevation="0" Class="quiet-disclosures"><MudExpansionPanel Text="Why this setting?"><MudText Typo="Typo.subtitle2">@explanation.Title</MudText><p>@explanation.Text</p></MudExpansionPanel></MudExpansionPanels>
   break;
 }
}
@if(!string.IsNullOrWhiteSpace(Step.ExpectedResult)) { <ExpectedResult Text="@Step.ExpectedResult" Label="@(Step.Section == GuideSection.TestAndTroubleshoot ? "Expected output" : "Expected result")"/> }
</div>
@code {
 [Parameter,EditorRequired] public GuideStep Step {get;set;}=null!;
 [Parameter,EditorRequired] public OAuthPlan Plan {get;set;}=null!;
 private string ComponentName => Plan.Scenario.Components.First(c=>c.Id==Step.ComponentId).Name;
 private IEnumerable<List<GuideContent>> Groups() {
  var groups=new List<List<GuideContent>>();
  foreach(var content in Step.Content) {
   if(groups.Count>0 && (content is InstructionContent i && string.IsNullOrEmpty(i.Title) && groups[^1][0] is InstructionContent || content is CopyableValueContent v && groups[^1][0] is CopyableValueContent previous && v.Value.ReferenceOnly == previous.Value.ReferenceOnly)) groups[^1].Add(content);
   else groups.Add(new() { content });
  }
  return groups;
 }
 private string GroupTitle(List<GuideContent> group) => group.OfType<InstructionContent>().Select(i=>i.Title).FirstOrDefault(t=>!string.IsNullOrEmpty(t)) ?? (Step.Section switch { GuideSection.Prerequisites => "Prerequisites", GuideSection.TestAndTroubleshoot => "Validate the flow", _ => "Configure the application" });
 private static IReadOnlyList<string> PortalPath(IReadOnlyList<string> path) => path.Count>0 && path[0] == "Entra admin center" ? path.Skip(1).ToArray() : path;
}
