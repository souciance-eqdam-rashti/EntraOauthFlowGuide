@using EntraAdvisor.Guide.Contracts
@foreach(var content in Step.Content) {
    @switch(content) {
        case CopyableValueContent value:
            <div class="value-guidance"><strong>@value.Value.Label</strong><p>@value.Value.Guidance</p></div>
            break;
        case PortalActionContent portal:
            <p class="breadcrumbs">@string.Join(" → ",portal.Breadcrumbs)</p><p>@portal.Action</p>
            break;
        case InstructionContent instruction:
            <p>@instruction.Text</p>
            break;
        case CodeContent snippet:
            <details class="step-code"><summary>@snippet.Artifact.DestinationFile · @snippet.Artifact.Language</summary><pre><code>@((MarkupString)CodeHighlighter.Render(snippet.Artifact.Content))</code></pre></details>
            break;
        case ExplanationContent explanation:
            <details class="step-detail"><summary>@explanation.Title</summary><p>@explanation.Text</p></details>
            break;
    }
}
@code {
    [Parameter,EditorRequired] public GuideStep Step {get;set;}=null!;
    [Parameter,EditorRequired] public OAuthPlan Plan {get;set;}=null!;
}
