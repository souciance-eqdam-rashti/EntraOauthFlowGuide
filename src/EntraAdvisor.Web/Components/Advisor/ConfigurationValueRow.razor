<div class="configuration-row">
 <div class="configuration-label"><MudText Typo="Typo.subtitle2">@Value.Label</MudText>@if(Value.Kind != GuideValueKind.Derived) { <MudText Typo="Typo.caption" Color="Color.Default">@KindLabel</MudText> }</div>
 <div class="configuration-value"><span class="@(Value.IsTechnical ? "technical-setting" : "ordinary-setting")">@Value.Value</span></div>
</div>
@if(!string.IsNullOrWhiteSpace(Value.Guidance)) { <p class="configuration-guidance">@Value.Guidance</p> }
@code {
 [Parameter, EditorRequired] public GuideValue Value {get;set;}=null!;
 private string KindLabel => Value.Kind switch { GuideValueKind.DeveloperSupplied => "Placeholder — replace with your Entra value", GuideValueKind.Sample => "Example — choose for your application", _ => "Required setting" };
}
