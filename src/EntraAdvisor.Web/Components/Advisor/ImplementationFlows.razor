<section class="question-help" aria-label="Authentication methods">
    <strong>Authentication methods used</strong>
    @foreach(var flow in Flows) {
        var source=EntraAdvisor.Guide.ArchitectureGuideGenerator.FlowSource(flow);
        <p><strong>@source.Title</strong> · <a href="@source.Url" target="_blank" rel="noopener">Microsoft Learn ↗</a></p>
    }
    @if(Plan.ApiValidation.Any(v => v.ComponentId == ComponentId)) { <p><strong>API token validation and authorization</strong> · <a href="https://learn.microsoft.com/en-us/entra/identity-platform/scenario-protected-web-api-app-configuration" target="_blank" rel="noopener">Microsoft Learn ↗</a></p> }
</section>
@code {
    [Parameter, EditorRequired] public OAuthPlan Plan {get;set;}=null!;
    [Parameter, EditorRequired] public string ComponentId {get;set;}="";
    private IEnumerable<TokenAcquisition> Flows => Plan.Relationships.Where(h=>Plan.Scenario.Relationships.Single(r=>r.Id==h.RelationshipId).CallerComponentId==ComponentId).Select(h=>h.Acquisition).Concat(Plan.Components.Where(c=>c.ComponentId==ComponentId && c.SignIn != SignInApproach.None).Select(c=>c.SignIn == SignInApproach.DeviceCode ? TokenAcquisition.DeviceCode : TokenAcquisition.AuthorizationCode)).Distinct();
}
