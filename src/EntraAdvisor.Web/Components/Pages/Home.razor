@page "/"
@inject AdvisorWorkspace W
@inject DesignJourneyState Design
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject GenerateGuide GuideWorkflow
<PageTitle>Entra OAuth Advisor</PageTitle>
<MudAppBar Fixed="false" Elevation="0" Class="advisor-appbar"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Color="Color.Primary" /><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="Reset" Class="brand-title">Entra OAuth Advisor</MudButton><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OpenConcepts" StartIcon="@Icons.Material.Outlined.MenuBook" Class="core-concepts-button">Core concepts</MudButton></MudAppBar>
<main class="@(W.Stage == JourneyStage.Implement ? "implement-page" : "")">
<nav aria-label="Journey"><MudTabs ActivePanelIndex="@((int)W.Stage)" ActivePanelIndexChanged="index => Navigate((JourneyStage)index)" Elevation="0" Rounded="true" Class="journey-tabs"><MudTabPanel Text="Design" Icon="@Icons.Material.Outlined.Tune" /><MudTabPanel Text="Implement" Icon="@Icons.Material.Outlined.Code" Disabled="@(W.Session.Evaluation.Plan is null)" /></MudTabs></nav>
<div class="workspace choosing-topology"><section class="work-panel">
<p class="eyebrow">@W.Stage · Enterprise Entra identities</p><h1 tabindex="-1" @ref="heading">@Title</h1>@if(!string.IsNullOrEmpty(message)) { <p role="status" class="sr-only">@message</p> }
@if(W.Stage == JourneyStage.Design) { <DesignArchitecture Revision="journeyRevision" Ready="Generate" Changed="DesignChanged" /> }
else if(W.Stage == JourneyStage.Implement) { <ImplementationJourney StatusChanged="value => message = value" /> }
</section></div></main>
@code {
 private ElementReference heading;

 private string message="";
 private bool focus;
 private int journeyRevision;

 private void DesignChanged(string value) { message=value; focus=true; }
 private string Title => W.Stage switch { JourneyStage.Design => "Design your architecture", _ => "Build it, one step at a time" };
 protected override async Task OnAfterRenderAsync(bool firstRender) { if(focus) { focus=false; await heading.FocusAsync(); } }
 private void Navigate(JourneyStage stage) { if(stage == JourneyStage.Implement && !W.GuideIsCurrent) { Generate(); return; } W.Stage=stage; Design.Enter(); focus=true; message=""; }
 private void Generate() { message=""; GuideWorkflow.Execute(); focus=true; }
 private void Reset() { W.Reset(); Design.Reset(); journeyRevision++; message=""; focus=true; }
 private async Task OpenConcepts() => await Dialogs.ShowAsync<CoreConceptsDialog>("Core concepts", new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
}
