@page "/"
@inject AdvisorWorkspace W
@inject IJSRuntime JS
@using EntraAdvisor.Guide
<PageTitle>Entra OAuth Advisor</PageTitle>
<header><a href="/" @onclick="Reset" @onclick:preventDefault>◈ Entra OAuth Advisor</a><span>Architecture → implementation</span><button @onclick="Reset">Start over</button></header>
<main class="@(W.Stage == JourneyStage.Implement ? "implement-page" : "")">
<nav aria-label="Journey">@foreach(var stage in Enum.GetValues<JourneyStage>()) { <button aria-current="@(W.Stage == stage ? "step" : null)" disabled="@(stage != JourneyStage.Design && W.Session.Evaluation.Plan is null)" @onclick="() => Navigate(stage)">@((int)stage+1). @stage</button> }</nav>
<div class="workspace choosing-topology"><section class="work-panel">
<p class="eyebrow">@W.Stage · Enterprise Entra identities</p><h1 tabindex="-1" @ref="heading">@Title</h1><p role="status" class="feedback">@message</p>
@if(W.Stage == JourneyStage.Design) {
 if(!W.Started) {
 <p>Select a card to continue to the design questions. Your implementation guide appears once those questions are answered.</p><fieldset><legend>What are you building?</legend><div class="choices">@foreach(var p in TopologyPresets.All) { <label class="choice topology-choice" @onclick="() => SelectPreset(p.Id)"><input type="radio" name="topology"/><span class="choice-body"><strong>@p.Title</strong><span>@p.Description</span><span class="use-case">Example: @p.Example</span><span class="card-action">Select and continue →</span></span></label> }</div></fieldset>
 } else if(screen is not null) {
 <p>@screen.Section</p>@foreach(var q in screen.Questions) { <p class="question-context">@Context(q.SuppliesFact.EntityId)</p><ChoiceCards @key="q.Id" Question="q" Selected="@Selected(q.Id)" SelectedChanged="value => drafts[q.Id] = value"/> }
 <div class="actions"><button @onclick="Back">← Back</button><button class="primary" disabled="@screen.Questions.Any(q => Selected(q.Id) is null)" @onclick="Continue">Continue →</button></div>
 } else if(W.Session.Evaluation.Plan is not null) { <button class="primary" @onclick="() => Navigate(JourneyStage.Implement)">Open implementation →</button> }
 @foreach(var issue in W.Session.Evaluation.Issues.Where(_ => W.Session.Evaluation.Status != EvaluationStatus.NeedsClarification)) { <div class="notice"><strong>@issue.Explanation</strong><p>@issue.NextAction</p></div> }
}
else if(W.Stage == JourneyStage.Implement && W.GuideIsCurrent && W.Guide is {} guide) {
 var step = guide.Steps[W.ActiveStep];
 <div class="implementation-layout">
 <section class="implementation-step-pane" aria-label="Selected implementation step" id="implementation-step-pane">
 <article><p class="eyebrow">Step @(W.ActiveStep+1) · @Name(step.ComponentId)</p><h2 tabindex="-1" @ref="stepHeading">@step.Title</h2>@if(step.Section != GuideSection.Prerequisites) { <ImplementationFlows Plan="guide.Architecture" ComponentId="@step.ComponentId"/> }
 <CompactStepContent Step="step" Plan="guide.Architecture"/>
 @foreach(var source in step.Sources) { <p><a href="@source.Url" target="_blank" rel="noopener">@source.Title</a></p> }
 </article></section>
 <section class="implementation-step-selector" aria-label="Implementation steps"><h2>Implementation steps</h2><ol class="step-list">@for(var i=0;i<guide.Steps.Length;i++) { var index=i; <li><button aria-current="@(i == W.ActiveStep ? "step" : null)" @onclick="() => SelectStep(index)">@guide.Steps[i].Title</button></li> }</ol></section>
 </div>
 <ValidationExport @key="guide.PlanId" Plan="guide.Architecture"><button @onclick="Export">Export Markdown ↓</button><button @onclick="OpenDiagram">Diagram Overview</button></ValidationExport>

 <dialog id="diagram-overview" class="diagram-dialog" aria-labelledby="diagram-title"><div class="diagram-dialog-header"><h2 id="diagram-title">Diagram Overview</h2><button autofocus @onclick="CloseDiagram" aria-label="Close diagram overview">Close ✕</button></div><AuthenticationFlow Plan="guide.Architecture" ShowTechnical="true"/></dialog>

}
</section></div></main>
@code {
 private ElementReference heading;
 private ElementReference stepHeading;
 private bool focusStep;
 private QuestionScreen? screen;
 private readonly Stack<QuestionScreen> history = new();
 private readonly Dictionary<string,string> drafts = new();
 private string message="";
 private bool focus;

 private string Title => W.Stage switch { JourneyStage.Design => "Design your architecture", _ => "Build it, one step at a time" };
 protected override void OnInitialized() => screen=W.Session.NextScreen;
 protected override async Task OnAfterRenderAsync(bool firstRender) { if(focus) { focus=false; await heading.FocusAsync(); } if(focusStep) { focusStep=false; await JS.InvokeVoidAsync("advisor.resetStepPane"); await stepHeading.FocusAsync(preventScroll:true); } }
 private string? Selected(string id) => drafts.GetValueOrDefault(id) ?? (W.Session.Answers.TryGetValue(id,out var a) ? a.SelectedOptionIds[0] : null);
 private string Context(string id) { var r=W.Session.Scenario.Relationships.FirstOrDefault(r=>r.Id==id); return r is null ? Name(id) : Name(r.CallerComponentId)+" → "+Name(r.TargetResourceId); }
 private string Name(string id) => W.Session.Scenario.Components.FirstOrDefault(c => c.Id == id)?.Name ?? W.Session.Scenario.Resources.FirstOrDefault(r => r.Id == id)?.Name ?? id;
 private void SelectPreset(string id) { if(W.Started) return; W.ChoosePreset(id); history.Clear(); drafts.Clear(); Start(); }
 private void Start() { W.Started=true; screen=W.Session.NextScreen; focus=true; }
 private void Continue() { if(screen is null) return; var prior=screen; foreach(var q in prior.Questions) if(Selected(q.Id) is {} value && QuestionCatalog.IsRelevant(q,W.Session.Scenario)) message=DescribeChange(W.Apply(new(q.Id,[value]))); history.Push(prior); drafts.Clear(); screen=W.Session.NextScreen; if(W.Session.Evaluation.Plan is not null) { Generate(); } focus=true; }
 private string DescribeChange(AnswerChangeImpact impact) => W.Guide is null ? "Answers saved." : impact.Explanation;
 private void Back() { if(history.TryPop(out var prior)) { screen=prior; drafts.Clear(); } else { W.Started=false; } message=""; focus=true; }
 private void Edit(QuestionDefinition q) { W.Stage=JourneyStage.Design; screen=new(q.Section,[q]); drafts.Clear(); focus=true; }
 private void Navigate(JourneyStage stage) { if(stage == JourneyStage.Implement && !W.GuideIsCurrent) { Generate(); return; } W.Stage=stage; screen=W.Session.NextScreen; focus=true; message=""; }
 private void Generate() { message=""; W.SetGuide(new ArchitectureGuideGenerator().Generate(W.Session.Evaluation.Plan!,new([]))); focus=true; }
 private void SelectStep(int i) { W.SelectStep(i); focusStep=true; }
 private void Reset() { W.Reset(); history.Clear(); drafts.Clear(); screen=W.Session.NextScreen; message=""; focus=true; }
 private async Task OpenDiagram() => await JS.InvokeVoidAsync("advisor.openDiagram");
 private async Task CloseDiagram() => await JS.InvokeVoidAsync("advisor.closeDiagram");
 private async Task Copy(string value) { try { await JS.InvokeVoidAsync("advisor.copy",value); message="Copied to clipboard."; } catch(JSException) { message="Clipboard unavailable. Select and copy the displayed text."; } }
 private async Task Export() { if(!W.GuideIsCurrent) return; var text=new MarkdownGuideExporter().ExportMarkdown(W.Guide!);  try { await JS.InvokeVoidAsync("advisor.download","entra-implementation-guide.md",text); message=""; } catch(JSException) { message="Download could not start. Please try again."; } }
}
