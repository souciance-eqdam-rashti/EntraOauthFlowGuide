@using EntraAdvisor.Guide
@using EntraAdvisor.Guide.Provisioning
<section class="implementation-exports" aria-label="Implementation exports">
    <div class="actions">@ChildContent<MudButton Variant="Variant.Outlined" OnClick="() => Export(ValidationScriptFormat.CurlBash)" StartIcon="@Icons.Material.Outlined.FileDownload">Export curl (Bash)</MudButton><MudButton Variant="Variant.Outlined" OnClick="() => Export(ValidationScriptFormat.CurlWindows)" StartIcon="@Icons.Material.Outlined.FileDownload">Export curl (Windows)</MudButton><MudButton Variant="Variant.Outlined" OnClick="() => Export(ValidationScriptFormat.PowerShell)" StartIcon="@Icons.Material.Outlined.FileDownload">Export PowerShell</MudButton><MudButton Variant="Variant.Outlined" OnClick="() => OpenSetup(ProvisioningFormat.Bicep)" StartIcon="@Icons.Material.Outlined.FileDownload">Download Bicep</MudButton><MudButton Variant="Variant.Outlined" OnClick="() => OpenSetup(ProvisioningFormat.PowerShell)" StartIcon="@Icons.Material.Outlined.FileDownload">Download setup PowerShell</MudButton></div>
    @if(status.Length > 0) { <p role="status">@status</p> }
</section>
@code {
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter,EditorRequired] public OAuthPlan Plan {get;set;}=null!;
    [Inject] public BrowserDownload Download {get;set;}=null!;
    [Inject] public IDialogService Dialogs {get;set;}=null!;
    private async Task OpenSetup(ProvisioningFormat format) => await Dialogs.ShowAsync<ProvisioningExportDialog>("Set up Entra",new DialogParameters { [nameof(ProvisioningExportDialog.Plan)]=Plan,[nameof(ProvisioningExportDialog.Format)]=format },new DialogOptions { MaxWidth=MaxWidth.Medium,FullWidth=true,CloseButton=true });
    private readonly ValidationScriptExporter exporter=new();
    private string status="";
    private async Task Export(ValidationScriptFormat format) {
        var script=exporter.ExportAll(Plan,format);
        status="";
        try {await Download.TextAsync(script.FileName,script.Content);} catch(JSException) {status="Download could not start. Please try again.";}
    }
}
