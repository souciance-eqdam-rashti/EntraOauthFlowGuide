<Project Sdk="Aspire.AppHost.Sdk/13.6.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <!-- This .NET-only AppHost uses SDK-restored orchestration; no Aspire CLI is required. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>a6a3777c-ea0a-40ae-9b05-883ca21a6aba</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EntraAdvisor.Web/EntraAdvisor.Web.csproj" />
  </ItemGroup>
</Project>
